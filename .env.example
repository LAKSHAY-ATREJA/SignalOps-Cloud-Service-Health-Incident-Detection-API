SIGNALOPS_DATABASE_URL=sqlite+aiosqlite:///./signalops.db
SIGNALOPS_INCIDENT_Z_THRESHOLD=2.5
SIGNALOPS_MINIMUM_SAMPLES=5
# Set true outside local demo mode, then provide one or more comma-separated
# lowercase SHA-256 digests of API keys. Raw keys are never stored in config.
SIGNALOPS_AUTH_REQUIRED=false
SIGNALOPS_API_KEY_SHA256=

